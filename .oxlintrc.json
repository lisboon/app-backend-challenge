{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "import"],
  "rules": {
    "curly": "error",
    "import/newline-after-import": "error",
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "scripts/**/*.ts"],
      "rules": {
        "typescript/explicit-function-return-type": "error"
      }
    },
    {
      "files": [
        "src/modules/**/domain/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/*",
                  "@mikro-orm/*",
                  "@aws-sdk/*",
                  "class-validator",
                  "class-transformer",
                  "**/infra/**",
                  "**/gateway/**",
                  "**/repository/**",
                  "**/usecase/**",
                  "**/factory/**"
                ],
                "message": "O domínio é TypeScript puro: framework, ORM e adaptadores entram por portas."
              },
              {
                "group": [
                  "**/wallet/**",
                  "**/wagering/**"
                ],
                "message": "Um contexto só conhece outro pela factory: domain, usecase e gateway falam com portas do próprio contexto."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/modules/**/usecase/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/*",
                  "@mikro-orm/*",
                  "@aws-sdk/*",
                  "class-validator",
                  "class-transformer",
                  "**/infra/**",
                  "**/repository/**",
                  "**/factory/**"
                ],
                "message": "Use case depende do domínio e de portas (gateway/). Framework, persistência e transporte ficam na borda."
              },
              {
                "group": [
                  "**/wallet/**",
                  "**/wagering/**"
                ],
                "message": "Um contexto só conhece outro pela factory: domain, usecase e gateway falam com portas do próprio contexto."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/modules/**/gateway/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/*",
                  "@mikro-orm/*",
                  "@aws-sdk/*",
                  "**/infra/**",
                  "**/repository/**",
                  "**/usecase/**",
                  "**/factory/**"
                ],
                "message": "Gateway é contrato: depende só do domínio."
              },
              {
                "group": [
                  "**/wallet/**",
                  "**/wagering/**"
                ],
                "message": "Um contexto só conhece outro pela factory: domain, usecase e gateway falam com portas do próprio contexto."
              }
            ]
          }
        ]
      }
    }
  ]
}
